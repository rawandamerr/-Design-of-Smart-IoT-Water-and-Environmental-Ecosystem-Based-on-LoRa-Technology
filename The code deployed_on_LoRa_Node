void downLinkDataHandle(McpsIndication_t *mcpsIndication) {
  // Check if we received the "0x01" command from the Dashboard
  if (mcpsIndication->BufferSize > 0 && mcpsIndication->Buffer[0] == 0x01) {
    
    // 1. Visual Alert on OLED
    oled.clear();
    oled.setFont(ArialMT_Plain_16);
    oled.setTextAlignment(TEXT_ALIGN_CENTER);
    oled.drawString(64, 10, "REMOTE ALARM");
    oled.setFont(ArialMT_Plain_10);
    oled.drawString(64, 35, "Command Received");
    oled.display();

    // 2. Turn on the Red Light (and turn off others for clarity)
    digitalWrite(LED_GREEN, LOW);
    digitalWrite(LED_YELLOW, LOW);
    digitalWrite(LED_RED, HIGH);

    // 3. Trigger the Buzzer sequence
    for (int i = 0; i < 10; i++) { 
      digitalWrite(BUZZER_PIN, HIGH); 
      delay(150); 
      digitalWrite(BUZZER_PIN, LOW); 
      delay(150); 
    }

    // 4. Reset the screen switch timer so the message stays visible for a moment
    lastScreenSwitch = millis(); 
  }
}
