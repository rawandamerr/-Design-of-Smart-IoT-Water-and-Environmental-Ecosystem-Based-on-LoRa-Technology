// ==================== HELPERS ====================
static void putU16LE(uint8_t* b, int i, uint16_t v) {
  b[i] = v & 0xFF;
  b[i + 1] = (v >> 8) & 0xFF;
}
static void putI16LE(uint8_t* b, int i, int16_t v) {
  putU16LE(b, i, (uint16_t)v);
}

