// ==================== SENSOR & TX LOGIC ====================
void updateRealTimeSensors() {
  float rawVoltage = analogRead(TDS_PIN) * 3.3f / 4095.0f;
  sensorData.temp = bmp.readTemperature();
  
  // Temperature Compensation Formula
  float compensationCoefficient = 1.0 + 0.02 * (sensorData.temp - 25.0);
  float compensationVoltage = rawVoltage / compensationCoefficient;
  
  // Conversion to PPM (Standard gravity-based constant for TDS sensors)
  sensorData.tdsPPM = (133.42 * pow(compensationVoltage, 3) - 255.86 * pow(compensationVoltage, 2) + 857.39 * compensationVoltage) * 0.5;

  sensorData.uvV = analogRead(UV_PIN) * 3.3f / 4095.0f;
  sensorData.pressure = bmp.readPressure() / 100.0f;
  sensorData.altitude = bmp.readAltitude(1013.25f); 
  sensorData.valid = true;

  // Real-Time Traffic Light Logic (Updated for PPM thresholds)
  // Usually: < 300 PPM is Excellent, 300-600 is Good, > 600 is Poor
  if (sensorData.tdsPPM <= 300) {
    digitalWrite(LED_GREEN, HIGH); 
    digitalWrite(LED_YELLOW, LOW); 
    digitalWrite(LED_RED, LOW);
  } else if (sensorData.tdsPPM <= 600) {
    digitalWrite(LED_GREEN, LOW); 
    digitalWrite(LED_YELLOW, HIGH); 
    digitalWrite(LED_RED, LOW);
  } else {
    digitalWrite(LED_GREEN, LOW); 
    digitalWrite(LED_YELLOW, LOW);
    digitalWrite(LED_RED, HIGH);
    digitalWrite(BUZZER_PIN, HIGH); 
    delay(100); 
    digitalWrite(BUZZER_PIN, LOW);
  }
}

static void prepareTxFrame(uint8_t port) {
  counter++;
  updateRealTimeSensors(); 

  uint16_t t = (uint16_t)(sensorData.temp * 100);
  uint16_t p = (uint16_t)(sensorData.pressure * 10);
  uint16_t tds = (uint16_t)(sensorData.tdsPPM); // Send PPM as a whole number
  uint16_t u = (uint16_t)(sensorData.uvV * 100);
  int16_t a = (int16_t)(sensorData.altitude * 10);

  appDataSize = 10;
  putU16LE(appData, 0, tds); 
  putU16LE(appData, 2, u);
  putI16LE(appData, 4, t);
  putU16LE(appData, 6, p);
  putI16LE(appData, 8, a);
}

// ==================== SETUP ====================
void setup() {
  Serial.begin(115200);
  
  pinMode(Vext, OUTPUT); 
  digitalWrite(Vext, LOW); 
  delay(50);
  pinMode(PRG_BUTTON, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(LED_GREEN, OUTPUT); 
  pinMode(LED_YELLOW, OUTPUT); 
  pinMode(LED_RED, OUTPUT);

  oled.init(); oled.flipScreenVertically();
  showDisplay("Initializing...");

  Wire1.begin(SDA_BMP, SCL_BMP);
  if (!bmp.begin(0x76)) { Serial.println("BMP280 Error!"); }

  Mcu.setlicense(license, HELTEC_BOARD);
  Mcu.begin(HELTEC_BOARD, SLOW_CLK_TPYE);
  
  LoRaWAN.init(loraWanClass, loraWanRegion);
  LoRaWAN.setDefaultDR(currentSF);
  appTxDutyCycle = sfDutyCycle[currentSF];
  
  showDisplay("Joining TTN...", "SF: SF" + String(12 - currentSF));
  LoRaWAN.join();
}

// ==================== MAIN LOOP ====================
void loop() {
  if (millis() - lastRealTimeCheck > 2000) {
    updateRealTimeSensors();
    lastRealTimeCheck = millis();
  }

  if (digitalRead(PRG_BUTTON) == LOW && !buttonPressed) {
    if (millis() - lastButtonPress > 300) {
      cycleSpreadingFactor();
      lastButtonPress = millis();
      buttonPressed = true;
    }
  } else if (digitalRead(PRG_BUTTON) == HIGH) {
    buttonPressed = false;
  }
  
  if (displaySF && (millis() - sfDisplayStart >= 2000)) {
    displaySF = false;
    updateCountdownDisplay();
  }
  
  if (!displaySF && (millis() - lastScreenSwitch >= screenSwitchInterval)) {
    currentScreen = (currentScreen + 1) % 3;
    lastScreenSwitch = millis();
    
    if (currentScreen == 1) displaySensorScreen1();
    else if (currentScreen == 2) displaySensorScreen2();
    else updateCountdownDisplay();
  }
  
  if (!displaySF && currentScreen == 0 && (millis() - lastDisplayUpdate >= 1000)) {
    updateCountdownDisplay();
    lastDisplayUpdate = millis();
  }
  
  if (millis() - lastSendTime >= appTxDutyCycle) {
    prepareTxFrame(appPort);
    if (!displaySF) showDisplay("Sending Data...", "UP: " + String(counter));
    
    LoRaWAN.send();
    lastSendTime = millis();
    lastDisplayUpdate = millis();
  }
  
    LoRaWAN.sleep(loraWanClass); 
}

